{
  "name": "sunsetrise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A 7-day forecast for beautiful sunrises and sunsets. Data by Open-Meteo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
